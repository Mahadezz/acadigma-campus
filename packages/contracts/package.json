{
  "name": "@acadigma/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zod schemas and inferred types shared by UI, server actions, jobs and tests.",
  "exports": {
    ".": "./src/index.ts",
    "./errors": "./src/errors.ts",
    "./result": "./src/result.ts",
    "./common": "./src/common.ts",
    "./settings": "./src/settings.ts",
    "./notifications": "./src/notifications.ts",
    "./plans": "./src/plans.ts",
    "./identity/auth": "./src/identity/auth.ts",
    "./identity/workspace": "./src/identity/workspace.ts",
    "./audit": "./src/audit.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
