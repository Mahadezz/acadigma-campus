{
  "name": "@acadigma/db",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Supabase clients, generated types and workspace context resolution.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./repositories": "./src/repositories/index.ts",
    "./workspace-context": "./src/workspace-context.ts",
    "./types": "./src/types.generated.ts",
    "./repositories/attendance-register": "./src/repositories/attendance-register.ts",
    "./repositories/reports": "./src/repositories/reports.ts",
    "./repositories/settings": "./src/repositories/settings.ts",
    "./repositories/staff": "./src/repositories/staff.ts",
    "./repositories/grading": "./src/repositories/grading.ts",
    "./repositories/exams": "./src/repositories/exams.ts",
    "./repositories/marks": "./src/repositories/marks.ts",
    "./repositories/results": "./src/repositories/results.ts",
    "./repositories/guardian-links": "./src/repositories/guardian-links.ts",
    "./repositories/ui-preferences": "./src/repositories/ui-preferences.ts",
    "./repositories/basic-home": "./src/repositories/basic-home.ts",
    "./repositories/class-hub": "./src/repositories/class-hub.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@acadigma/contracts": "workspace:*",
    "@acadigma/domain": "workspace:*",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@acadigma/config": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
