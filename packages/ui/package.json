    "./primitives/nav-config": "./src/primitives/nav-config.ts",
    "./primitives/link-renderer": "./src/primitives/link-renderer.ts",
    "./primitives/*": "./src/primitives/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/utils": "./src/lib/utils.ts",
    "./motion/*": "./src/motion/*.ts",
    "./motion/recipes.css": "./src/motion/recipes.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@acadigma/domain": "workspace:*",
    "@gsap/react": "2.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "gsap": "3.15.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.474.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react-day-picker": "9.14.0",
    "react-hook-form": "7.88.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@acadigma/config": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
