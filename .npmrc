# Keep the dependency graph honest: nothing resolves what it did not declare.
strict-peer-dependencies=false
auto-install-peers=true
# Deterministic installs in CI.
prefer-workspace-packages=true
link-workspace-packages=true
resolution-mode=highest
# Wait 7 days before resolving newly published package versions, so a
# compromised release has time to be caught and pulled before we install it.
min-release-age=7
