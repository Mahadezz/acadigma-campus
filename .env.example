# ---------------------------------------------------------------------------
# Acadigma Campus — copy to .env.local and fill in. .env.local is never committed.
# Only NEXT_PUBLIC_* values ever reach the browser (ARCHITECTURE §8).
# ---------------------------------------------------------------------------

# Supabase project `Acadigma Campus` (DECISION-LOG D-53, superseding D-19). Browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://kekfmibwjejdhxjkmezo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_VbUqiEvQiuObUZMf5IGYOA_P_EiiyGy

# Server only. Never prefix with NEXT_PUBLIC_. Used through withServiceRole(reason).
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, for migrations and pgTAP runs.
SUPABASE_DB_URL=

# Anthropic Claude — server only (DECISION-LOG D-08).
ANTHROPIC_API_KEY=

# SSLCommerz payments (DECISION-LOG D-09). Sandbox until go-live.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Transactional email.
RESEND_API_KEY=

# Error reporting. Leave empty to disable Sentry entirely.
SENTRY_DSN=

# OpenTelemetry (DECISION-LOG D-30). All optional — leave empty for a no-op
# exporter in local dev and CI. See docs/engineering/OBSERVABILITY.md §2.
OTEL_SERVICE_NAME=acadigma-campus
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Absolute origin of this deployment. Used for redirects, emails and webhooks.
APP_URL=http://localhost:3000

# Shared secret that Vercel Cron presents on /api/cron/* requests.
CRON_SECRET=

# Salts the throttle-bucket keys in auth_throttle (F-ID-01 §5) so a raw email or
# IP never sits in the table. Server only; rotate to invalidate all open windows.
THROTTLE_KEY_SALT=

# --- Tests --------------------------------------------------------------------
# Set to 1 only where the Supabase project has migrations + seed applied; enables
# the register / sign-in / throttle Playwright journeys (OQ-27).
E2E_LIVE_SUPABASE=

# Credentials for a seeded, verified account with zero school memberships —
# F-ID-05 Part 2's onboarding-chooser journey (apps/web/e2e/onboarding.spec.ts).
# Skipped whenever either is unset, same as E2E_LIVE_SUPABASE above (OQ-27).
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
# An owner of a school created through the wizard (F-AC-01 classes journey).
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
# A verified account that is not a member of the owner's school (guardian-invite journey, D-108).
E2E_PARENT_EMAIL=
E2E_PARENT_PASSWORD=
# The local stack's Mailpit (http://127.0.0.1:54324): the guardian sign-up journey reads the confirmation email there.
E2E_MAILPIT_URL=

# Set to 1 to run packages/db/src/repositories/academics.integration.test.ts
# against a local `supabase start` stack (PGRST201 regression, PR #61).
# ANON_KEY/SERVICE_KEY are required when set (printed by `supabase start` /
# `supabase status`); URL defaults to http://127.0.0.1:54321.
DB_LOCAL_SUPABASE=
DB_LOCAL_SUPABASE_URL=
DB_LOCAL_SUPABASE_ANON_KEY=
DB_LOCAL_SUPABASE_SERVICE_KEY=

# Set to also write packages/pdf/src/bulk-perf.test.ts's merged PDFs to disk
# for a manual pymupdf check (F-OP-03 Part 5, D-207). Local-only; CI has no
# `F:\` drive, so this stays unset there and the test only measures timing.
OPS_BULK_OUTPUT_DIR=

# Same as OPS_BULK_OUTPUT_DIR, for
# packages/pdf/src/register-marksheet-perf.test.ts (F-OP-03 Part 6, D-208).
OPS_REGISTER_OUTPUT_DIR=
