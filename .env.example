# ---------------------------------------------------------------------------
# Acadigma Campus — copy to .env.local and fill in. .env.local is never committed.
# Only NEXT_PUBLIC_* values ever reach the browser (ARCHITECTURE §8).
# ---------------------------------------------------------------------------

# Supabase project `acadigma-suite` (DECISION-LOG D-19). Browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://bvqzhrvcrxebawjusrxk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_6POCbYjBAcrSiT1AlCPSVQ_SG3ohfsL

# Server only. Never prefix with NEXT_PUBLIC_. Used through withServiceRole(reason).
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection, for migrations and pgTAP runs.
SUPABASE_DB_URL=

# Anthropic Claude — server only (DECISION-LOG D-08).
ANTHROPIC_API_KEY=

# SSLCommerz payments (DECISION-LOG D-09). Sandbox until go-live.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Transactional email.
RESEND_API_KEY=

# Error reporting. Leave empty to disable Sentry entirely.
SENTRY_DSN=

# OpenTelemetry (DECISION-LOG D-30). All optional — leave empty for a no-op
# exporter in local dev and CI. See docs/engineering/OBSERVABILITY.md §2.
OTEL_SERVICE_NAME=acadigma-campus
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Absolute origin of this deployment. Used for redirects, emails and webhooks.
APP_URL=http://localhost:3000

# Shared secret that Vercel Cron presents on /api/cron/* requests.
CRON_SECRET=

# Salts the throttle-bucket keys in auth_throttle (F-ID-01 §5) so a raw email or
# IP never sits in the table. Server only; rotate to invalidate all open windows.
THROTTLE_KEY_SALT=

# --- Tests --------------------------------------------------------------------
# Set to 1 only where the Supabase project has migrations + seed applied; enables
# the register / sign-in / throttle Playwright journeys (OQ-27).
E2E_LIVE_SUPABASE=
